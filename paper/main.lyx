\begin_inset Formula $t \in [\text{2009-04-01T00:00:00Z}, \text{2009-05-01T00:00:00Z})$
\end_inset

. The minimum timestamp is 
\family typewriter
2009-04-01 00:00:03
\family default
 and maximum is 
\family typewriter
2009-04-30 23:59:57
\family default
. 
\end_layout

\begin_layout Itemize

\series bold
Test Window (
\begin_inset Formula $\mathcal{D}_{\text{test}}$
\end_inset

):
\series default
